# Inspirare backend - example env. Copy to .env and fill in.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Supabase ---
# Find at: Supabase dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The "service_role" key. SERVER-SIDE ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...paste-the-long-jwt-here...

# The "anon" key. Safe to expose in the browser (we keep a copy server-side for some flows).
SUPABASE_ANON_KEY=eyJhbGciOi...paste-the-anon-jwt-here...

# --- CORS ---
# Origin(s) the frontend is served from during dev. Comma-separate for multiple.
FRONTEND_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# --- Session (reserved for v2 cookie flow) ---
# 32+ random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# --- Resend (password reset emails) ---
# Create an account at https://resend.com and grab an API key.
# Leave RESEND_API_KEY empty in dev: the 6-digit code is printed to the
# server console instead of being emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESET_CODE_TTL_MINUTES=10
RESET_MAX_ATTEMPTS=5
